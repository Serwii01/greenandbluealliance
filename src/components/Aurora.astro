---
/**
 * Fondo comun de los encabezados: azul profundo con dos halos, verde y azul,
 * que evocan el degradado del logo sin comprometer el contraste del texto.
 */
interface Props {
  /** 'compacto' concentra los halos a la derecha; 'ancho' los reparte. */
  reparto?: 'compacto' | 'ancho';
}
const { reparto = 'compacto' } = Astro.props;

const halos =
  reparto === 'compacto'
    ? [
        'bg-[radial-gradient(95%_120%_at_80%_32%,rgba(0,128,176,0.62),transparent_62%)]',
        'bg-[radial-gradient(70%_95%_at_92%_82%,rgba(88,176,24,0.45),transparent_58%)]',
      ]
    : [
        'bg-[radial-gradient(80%_130%_at_18%_100%,rgba(72,160,32,0.42),transparent_60%)]',
        'bg-[radial-gradient(85%_120%_at_85%_10%,rgba(0,128,176,0.55),transparent_60%)]',
      ];
---
<div class="absolute inset-0 bg-navy-950" aria-hidden="true"></div>
{halos.map((h) => <div class={`absolute inset-0 ${h}`} aria-hidden="true"></div>)}
<div
  class="absolute inset-0 bg-[linear-gradient(180deg,rgba(2,32,56,0.55)_0%,transparent_35%)]"
  aria-hidden="true"
></div>
