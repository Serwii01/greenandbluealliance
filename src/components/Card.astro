---
import Icono from './Icono.astro';
import type { NombreIcono } from '../lib/iconos';

interface Props {
  titulo: string;
  /** Numero o simbolo que se muestra en la esquina. Ignorado si se pasa `icono`. */
  indice?: string;
  /** Nombre de un icono de components/Icono.astro. */
  icono?: NombreIcono;
  acento?: 'verde' | 'azul' | 'navy';
  class?: string;
}
const { titulo, indice, icono, acento = 'navy', class: cls = '' } = Astro.props;

const barras = {
  verde: 'before:bg-leaf-600',
  azul: 'before:bg-blue-500',
  navy: 'before:bg-navy-800',
};
const marcas = {
  verde: 'text-leaf-700 bg-leaf-50',
  azul: 'text-blue-600 bg-blue-50',
  navy: 'text-navy-800 bg-slate-mist',
};
---
<article
  class={`group relative isolate flex h-full flex-col rounded-2xl border border-slate-line bg-white p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-lift sm:p-7
    before:absolute before:inset-x-0 before:top-0 before:h-1 before:rounded-t-2xl before:transition-all before:duration-300 hover:before:h-1.5 ${barras[acento]} ${cls}`}
>
  {(icono || indice) && (
    <span class={`mb-4 inline-flex size-11 items-center justify-center rounded-xl font-display text-sm font-bold ${marcas[acento]}`}>
      {icono ? <Icono nombre={icono} class="size-5.5" /> : indice}
    </span>
  )}
  <h3 class="text-lg leading-snug sm:text-xl">{titulo}</h3>
  <div class="mt-3 text-[0.975rem] leading-relaxed"><slot /></div>
</article>
