---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Pilares from '../../components/Pilares.astro';
import Icono from '../../components/Icono.astro';
import Wave from '../../components/Wave.astro';
import Aurora from '../../components/Aurora.astro';
import { url } from '../../lib/url';

export const getStaticPaths = async () => {
  const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
  return equipo.map((persona, i) => ({
    params: { slug: persona.id },
    props: {
      persona,
      anterior: equipo[i - 1] ?? equipo[equipo.length - 1],
      siguiente: equipo[i + 1] ?? equipo[0],
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { persona, anterior, siguiente } = Astro.props as Props;
const { Content } = await render(persona);
const d = persona.data;
---

<Base titulo={d.nombre} descripcion={`${d.cargo} de Green & Blue Alliance. ${d.titular}`}>
  <section class="relative overflow-hidden">
    <Aurora reparto="ancho" />

    <div class="gb-wrap relative pb-20 pt-10 sm:pb-24 sm:pt-14">
      <a
        href={url('/equipo/')}
        class="inline-flex items-center gap-2 text-sm font-semibold text-white/70 transition hover:text-white"
      >
        <Icono nombre="flecha" class="size-4 rotate-180" />
        Todo el equipo
      </a>

      <div class="mt-8 grid gap-10 lg:grid-cols-[280px_1fr] lg:gap-14">
        <Image
          src={d.fotoFicha}
          alt={d.alt}
          widths={[280, 560]}
          sizes="280px"
          loading="eager"
          class="aspect-4/5 w-full max-w-[280px] rounded-2xl object-cover shadow-lift ring-1 ring-white/15"
        />

        <div>
          <p class="font-display text-xs font-bold uppercase tracking-[0.2em] text-leaf-500">
            {d.cargo}
          </p>
          <h1 class="mt-3 text-4xl text-white sm:text-5xl">{d.nombre}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">{d.titular}</p>
        </div>
      </div>
    </div>

    <Wave color="#ffffff" class="relative" />
  </section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.35fr_0.65fr] lg:gap-16">
      <div class="gb-prose max-w-2xl">
        <Content />
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-slate-line bg-slate-mist p-7">
          <h2 class="text-lg leading-snug">{d.pilaresTitulo}</h2>
          <Pilares pilares={d.pilares} acento="verde" class="mt-6" />
        </div>
      </aside>
    </div>
  </Section>

  {/* ---------- Navegacion entre perfiles ---------- */}
  <Section fondo="mist" class="!py-12">
    <nav class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" aria-label="Otros perfiles">
      <a
        href={url(`/equipo/${anterior.id}/`)}
        class="group flex items-center gap-3 text-left"
        rel="prev"
      >
        <Icono nombre="flecha" class="size-5 rotate-180 text-blue-600 transition-transform group-hover:-translate-x-1" />
        <span>
          <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-body">Anterior</span>
          <span class="font-display font-semibold text-navy-800">{anterior.data.nombre}</span>
        </span>
      </a>
      <a
        href={url(`/equipo/${siguiente.id}/`)}
        class="group flex items-center gap-3 text-left sm:text-right"
        rel="next"
      >
        <span>
          <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-body">Siguiente</span>
          <span class="font-display font-semibold text-navy-800">{siguiente.data.nombre}</span>
        </span>
        <Icono nombre="flecha" class="size-5 text-blue-600 transition-transform group-hover:translate-x-1" />
      </a>
    </nav>
  </Section>
</Base>
